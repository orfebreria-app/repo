# Public client configuration only. Do not put service-role keys, database passwords,
# SMTP passwords, private keys, or real customer data in this file.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key

# Server-only configuration. Set these in the hosting provider's environment settings.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_rotated_smtp_password
SMTP_FROM=Facturacion <no-reply@example.invalid>

# Use a pooled server-side connection only where the backend requires it.
DATABASE_URL=postgresql://app_user:replace_with_rotated_password@db.example.invalid:5432/app_db
